{
  "compilerOptions": {
    "module": "System",
    "target": "es6",
    //"strict": true,
    "lib": [
      "es2020",
      "dom"
    ],
    "strictNullChecks": false,
    "noEmitHelpers": true,
    "sourceMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "noEmit": true
  },
  "include": [
    "./assets",
    "./src",
    "./engine"
  ]
}